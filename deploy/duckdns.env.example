# 이 파일을 deploy/duckdns.env 로 복사해서 채우세요. (duckdns.env 는 git에 올라가지 않습니다)
#
# 1) https://www.duckdns.org 에서 로그인 → sub domain 칸에 이름을 넣고 add domain
# 2) 같은 화면 위쪽의 token 값을 복사

# 이름만 (.duckdns.org 는 빼고). 예: goranibaduk → https://goranibaduk.duckdns.org
DUCKDNS_DOMAIN=goranibaduk

# DuckDNS 화면에 보이는 token (비밀번호처럼 남에게 보여 주지 마세요)
DUCKDNS_TOKEN=
